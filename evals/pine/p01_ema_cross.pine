//@version=5
strategy("EMA 9/21 cross", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=20)

fastLen = input.int(9, "Fast EMA")
slowLen = input.int(21, "Slow EMA")
fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)

if ta.crossover(fast, slow)
    strategy.entry("Long", strategy.long)
if ta.crossunder(fast, slow)
    strategy.close("Long")

// 2% protective stop below the average entry price
strategy.exit("Stop", "Long", stop=strategy.position_avg_price * 0.98)

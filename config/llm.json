{
  "prices_checked": "2026-10-12",
  "price_sources": {
    "deepseek": "https://api-docs.deepseek.com/quick_start/pricing (via the synced mirror github.com/thevibeworks/deepseek-docs; the docs host is blocked from the build sandbox)",
    "moonshot": "https://platform.kimi.ai/docs/pricing/chat (search-engine excerpts only; re-check before relying on them)",
    "anthropic": "Claude API skill model table and pricing notes, cached 2026-10-06"
  },
  "budget_usd": {"total": 3.0, "eval": 1.0},
  "default_writer": "deepseek",
  "judge_preference": ["anthropic:claude-opus-5-5", "moonshot:kimi-k3", "deepseek:deepseek-v4-pro"],
  "providers": {
    "deepseek": {
      "sdk": "openai",
      "key_env": "DEEPSEEK_API_KEY",
      "base_url": "https://api.deepseek.com",
      "beta_base_url": "https://api.deepseek.com/beta",
      "modes": ["strict_tools", "json_object"],
      "defs_key": "$def",
      "writer": "deepseek-flash",
      "escalation": "deepseek-v4-pro",
      "extra_body": {"thinking": {"type": "disabled"}},
      "max_output_tokens": 8192,
      "data_location": "People's Republic of China (Hangzhou DeepSeek AI; per its privacy policy)",
      "peak_hours_utc": [[1, 4], [6, 10]],
      "peak_weekdays": [0, 1, 2, 3, 4],
      "models": {
        "deepseek-flash": {
          "input": 0.30, "cached_input": 0.006, "output": 1.20,
          "off_peak": {"input": 0.15, "cached_input": 0.003, "output": 0.60}
        },
        "deepseek-v4-pro": {
          "input": 1.32, "cached_input": 0.044, "output": 3.96,
          "off_peak": {"input": 0.66, "cached_input": 0.022, "output": 1.98}
        }
      }
    },
    "moonshot": {
      "sdk": "openai",
      "key_env": "MOONSHOT_API_KEY",
      "base_url": "https://api.moonshot.ai/v1",
      "modes": ["json_schema", "json_object"],
      "defs_key": "$defs",
      "writer": "kimi-k2.6",
      "escalation": "kimi-k3",
      "model_extra_body": {"kimi-k2.6": {"thinking": {"type": "disabled"}}},
      "max_output_tokens": 8192,
      "max_tokens_param": "max_completion_tokens",
      "data_location": "Singapore (MOONSHOT AI PTE. LTD.; parent company in Beijing)",
      "models": {
        "kimi-k2.6": {"input": 0.95, "cached_input": 0.16, "output": 4.00},
        "kimi-k3": {"input": 3.00, "cached_input": 0.30, "output": 15.00}
      }
    },
    "anthropic": {
      "sdk": "anthropic",
      "key_env": "ANTHROPIC_API_KEY",
      "modes": ["json_schema", "json_prompt"],
      "defs_key": "$defs",
      "writer": "claude-haiku-5-5",
      "escalation": null,
      "effort": "low",
      "max_output_tokens": 16000,
      "data_location": "United States (Anthropic API; inference_geo reported per request)",
      "models": {
        "claude-haiku-5-5": {
          "input": 0.10, "cached_input": 0.01, "cache_write": 0.125, "output": 0.50,
          "long_context_tokens": 100000,
          "long_context": {"input": 0.50, "cached_input": 0.05, "cache_write": 0.625, "output": 2.50}
        },
        "claude-opus-5-5": {"input": 4.00, "cached_input": 0.20, "cache_write": 5.00, "output": 20.00}
      }
    }
  }
}

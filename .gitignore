# Secrets
.env
.env.*
!.env.example

# Data (downloaded, never committed) -- small fixtures are the exception
data/*
!data/.gitkeep

# Runtime state
*.sqlite
*.sqlite3
*.db
runs/
catalog/

# Python / tooling caches
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Node (dukascopy-node via npx)
node_modules/

# Vendored UI assets (downloaded by `make setup` as an offline fallback for the CDN)
strategy_lab/ui/static/vendor/

# OS / editors
.DS_Store
.idea/
.vscode/
